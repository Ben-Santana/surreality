{
  "name": "@surreality/desktop",
  "productName": "Surreality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "dist:mac:adhoc": "npm run build && electron-builder --mac dmg --arm64 --config.mac.identity=- --config.mac.notarize=false && codesign --verify --deep --strict --verbose=2 release/mac-arm64/Surreality.app",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test": "node --test tests/*.test.mjs",
    "create:mapping": "node scripts/create-mapping.mjs",
    "pack:mapping": "node scripts/pack-mapping.mjs",
    "preview": "vite preview",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dist:arch": "npm run build && electron-builder --linux pacman --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.surreality.desktop",
    "productName": "Surreality",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Surreality-${version}-${arch}.${ext}",
      "title": "Surreality ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Surreality-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "executableName": "surreality",
      "icon": "build/icon.png",
      "category": "Graphics",
      "target": [
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true
    },
    "pacman": {
      "packageName": "surreality",
      "maintainer": "Ben-Santana",
      "artifactName": "surreality-${version}-1-x86_64.pkg.tar.zst",
      "compression": "zstd",
      "depends": [
        "alsa-lib",
        "at-spi2-core",
        "cairo",
        "dbus",
        "expat",
        "gcc-libs",
        "glib2",
        "glibc",
        "gtk3",
        "libcups",
        "libdrm",
        "libx11",
        "libxcb",
        "libxcomposite",
        "libxdamage",
        "libxext",
        "libxfixes",
        "libxkbcommon",
        "libxrandr",
        "mesa",
        "nspr",
        "nss",
        "pango",
        "xdg-utils"
      ],
      "fpm": [
        "--description",
        "Projection mapping for rooms, surfaces, and live visuals."
      ]
    }
  },
  "description": "Projection mapping for rooms, surfaces, and live visuals.",
  "homepage": "https://github.com/Ben-Santana/surreality",
  "desktopName": "surreality.desktop"
}
