{
  "name": "@surreality/desktop",
  "productName": "Surreality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test": "node --test tests/*.test.mjs",
    "create:mapping": "node scripts/create-mapping.mjs",
    "pack:mapping": "node scripts/pack-mapping.mjs",
    "preview": "vite preview",
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vite-plugin-electron": "^0.29.0"
  }
}
