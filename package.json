{
  "name": "surreality",
  "private": true,
  "scripts": {
    "bootstrap": "npm install --prefix apps/desktop && npm install --prefix apps/docs",
    "dev": "npm run dev --prefix apps/desktop",
    "dev:desktop": "npm run dev --prefix apps/desktop",
    "dev:docs": "npm run dev --prefix apps/docs",
    "build": "npm run build --prefix apps/desktop",
    "build:desktop": "npm run build --prefix apps/desktop",
    "build:docs": "npm run build --prefix apps/docs",
    "build:all": "npm run build:desktop && npm run build:docs",
    "check": "npm run check --prefix apps/desktop && npm run check --prefix apps/docs",
    "test": "npm run test --prefix apps/desktop",
    "create:mapping": "npm run create:mapping --prefix apps/desktop --",
    "pack:mapping": "npm run pack:mapping --prefix apps/desktop --",
    "build:mappings": "npm run build:mappings --prefix apps/desktop",
    "preview": "npm run preview --prefix apps/desktop",
    "start": "npm run start --prefix apps/desktop"
  }
}
